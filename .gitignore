# ============================================================
# IndigoKit — .gitignore
# ============================================================

# ---------- Node / npm ----------
node_modules/

# ---------- npm debug / log files ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Sass ----------
.sass-cache/

# ---------- OS files ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- VS Code local configuration ----------
.vscode/

# ---------- Temporary files ----------
*.tmp
*.temp
*.swp
*.swo

# ---------- Agent / AI tooling ----------
.agents/
.claude/
.freebuff/
agent/

# ------------------------------------------------------------
# NOTE: dist/ is intentionally NOT ignored.
#
# IndigoKit is intended to eventually support downloadable compiled
# CSS/JS, so whether release artifacts should be committed must
# remain an explicit decision. For now dist/ stays tracked.
# Revisit when the release/distribution policy is set.
# ------------------------------------------------------------